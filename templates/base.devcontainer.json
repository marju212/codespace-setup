{
  "name": "Base",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "[ -d ~/.dotfiles ] || git clone https://github.com/marju212/codespace-setup ~/.dotfiles; ~/.dotfiles/install.sh; echo 'Base environment ready!'"
}
